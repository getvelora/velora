#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEV_COMPOSE_FILE="$ROOT_DIR/compose.dev.yml"
GOLANGCI_LINT_VERSION="v2.12.2"

usage() {
  cat <<'USAGE'
Usage: ./velora <command> [options]

Commands:
  create [--postgres]  Build and start the local environment
  destroy              Stop the local environment and preserve volumes
  clean                Stop the local environment and remove compose volumes
  status               Show local environment status
  logs                 Follow local environment logs
  web-build             Build web assets without rebuilding the application image
  lint                  Run the pinned Go linter
USAGE
}

run_compose() {
  (cd "$ROOT_DIR" && docker compose --project-name velora --file "$DEV_COMPOSE_FILE" "$@")
}

create_env() {
  load_env_file
  local compose_args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --postgres)
        use_local_postgres
        compose_args+=(--profile postgres)
        ;;
      *)
        echo "Unknown create option: $1" >&2
        exit 1
        ;;
    esac
    shift
  done

  mkdir -p \
    "$ROOT_DIR/${VELORA_HOST_MEDIA_DIR:-./dev/media}" \
    "$ROOT_DIR/${VELORA_HOST_CACHE_DIR:-./dev/cache}" \
    "$ROOT_DIR/${VELORA_HOST_CONFIG_DIR:-./dev/config}"
  web_build false
  run_compose "${compose_args[@]}" up -d --build --remove-orphans
}

use_local_postgres() {
  export VELORA_DATABASE_DRIVER=postgres
  export VELORA_DATABASE_URL="postgres://${POSTGRES_USER:-velora}:${POSTGRES_PASSWORD:-velora}@${POSTGRES_HOST:-postgres}:5432/${POSTGRES_DB:-velora}?sslmode=disable"
}

load_env_file() {
  local env_file="$ROOT_DIR/.env"
  if [[ -f "$env_file" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$env_file"
    set +a
  fi
}

destroy_env() {
  run_compose down --remove-orphans
}

clean_env() {
  run_compose down --volumes --remove-orphans
}

status_env() {
  run_compose ps
}

logs_env() {
  run_compose logs -f
}

web_build() {
  local refresh_service="${1:-true}"

  export VELORA_HOST_UID
  export VELORA_HOST_GID
  VELORA_HOST_UID="$(id -u)"
  VELORA_HOST_GID="$(id -g)"
  run_compose run --rm --no-deps web-build

  if [[ "$refresh_service" == "true" ]] &&
    [[ "$(run_compose ps --status running --services velora)" == "velora" ]]; then
    run_compose up -d --no-build --no-deps velora
  fi
}

lint_go() {
  docker run --rm \
    -e GOCACHE=/app/.cache/go-build \
    -e GOMODCACHE=/app/.cache/go-mod \
    -v "$ROOT_DIR/apps/server:/app" \
    -w /app \
    "golangci/golangci-lint:$GOLANGCI_LINT_VERSION" \
    golangci-lint run
}

main() {
  local command="${1:-}"

  case "$command" in
    create)
      shift || true
      create_env "$@"
      ;;
    destroy)
      destroy_env
      ;;
    clean)
      clean_env
      ;;
    status)
      status_env
      ;;
    logs)
      logs_env
      ;;
    web-build)
      web_build
      ;;
    lint)
      lint_go
      ;;
    -h|--help|help|"")
      usage
      ;;
    *)
      echo "Unknown command: $command" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
